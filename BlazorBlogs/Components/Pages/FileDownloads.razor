@page "/filedownloads"
@using BlazorBlogs.Data
@using BlazorBlogs.Data.Models
@using Microsoft.AspNetCore.Identity
@using System.Globalization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject IHttpContextAccessor HttpContextAccessor
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject DisqusState DisqusState
@inject IToastService ToastService
@inherits OwningComponentBase

<div class="bb-page-header">
    <div>
        <p class="bb-muted">Files from this site</p>
        <h1>Downloads</h1>
    </div>
    @if (UserIsAnAdmin)
    {
        <button type="button" class="btn btn-primary" @onclick="UploadFile">Upload file</button>
    }
</div>
@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
@if (Buy.HasValue)
{
    <div class="alert alert-info">This download must be purchased.</div>
}
<div class="download-grid">
@foreach (var file in OrderedFiles)
{
    <article class="download-card bb-card">
        <div class="download-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" />
            </svg>
        </div>
        <div class="download-card-body">
            <h2>@file.FileName</h2>
            @if (!string.IsNullOrWhiteSpace(file.Description))
            {
                <p class="download-description">@file.Description</p>
            }
            <div class="bb-badge">@(file.Price == 0 ? "Free" : file.Owned ? "Purchased" : $"{file.Price:0.00} {StripeSettings.Currency.ToUpperInvariant()}")</div>
            @if (file.Price > 0)
            {
                <p class="bb-muted">
                    @StripeSettings.Currency.ToUpperInvariant()
                    @(StripeSettings.AutomaticTax && StripeSettings.TaxBehavior == "exclusive" ? " · tax calculated at checkout" : "")
                </p>
            }
        </div>
        <div class="download-actions">
        @if (UserIsAnAdmin)
        {
            <button type="button" class="btn btn-secondary" aria-label="@($"Edit {file.FileName}")" @onclick="(() => EditFile(file))">Edit</button>
        }
        @if (UserIsAnAdmin || file.Price == 0 && UserIsLoggedIn || file.Owned)
        {
            <a class="btn btn-primary" href="api/File/Download/@file.FileId">Download</a>
        }
        else if (file.Price > 0)
        {
            @if (StripeSettings.Enabled && StripeSettings.IsConfigured)
            {
                <button class="btn btn-primary" @onclick="(() => BuyFile(file))">Buy now</button>
            }
            else
            {
                <button class="btn btn-secondary" disabled>Not available</button>
            }
        }
        else
        {
            <a class="btn btn-secondary" href="Account/Login">Sign in to download</a>
        }
        </div>
    </article>
}
</div>
<div class="download-help">
    <a href="downloads/resend">Lost your download link?</a>
    <span>Payments and applicable tax are securely processed by Stripe.</span>
</div>

@if (LoadingFiles)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <nav class="pager" aria-label="Download pages">
        <button class="btn btn-secondary" disabled="@(!ShowPreviousButton)" @onclick="Previous">← Previous</button>
        <button class="btn btn-secondary" disabled="@(!ShowNextButton)" @onclick="Next">Next →</button>
    </nav>
}

@if (FileUploadPopup)
{
    <div class="modal" tabindex="-1" style="display:block" role="dialog">
        <div class="modal-dialog"><div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Upload File</h3>
                <button type="button" class="close" @onclick="CloseUploadPopup"><span>X</span></button>
            </div>
            <div class="modal-body">
                <label>File Name</label>
                <input class="form-control" @bind="SelectedFile.FileName" />
                <label>Price</label>
                <input class="form-control" type="number" min="0" step="0.01" @bind="SelectedFile.Price" />
                <label>Description</label>
                <textarea class="form-control" maxlength="4000" rows="5" @bind="SelectedFile.Description"></textarea>
                <RadzenUpload ChooseText="Upload And Save" Multiple="false" Accept=".zip,application/zip"
                              Url="@($"api/upload/single?FileTitle={Uri.EscapeDataString(SelectedFile.FileName ?? "")}&Price={SelectedFile.Price.ToString(CultureInfo.InvariantCulture)}")"
                              Style="margin-bottom:20px;height:45px"
                              Complete="OnUploadComplete" Error="OnUploadError" />
            </div>
        </div></div>
    </div>
}

@if (FileEditPopup)
{
    <div class="modal" tabindex="-1" style="display:block" role="dialog">
        <div class="modal-dialog"><div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Edit File</h3>
                <button type="button" class="close" @onclick="ClosePopup"><span>X</span></button>
            </div>
            <div class="modal-body">
                <label>File Name</label>
                <input class="form-control" @bind="SelectedFile.FileName" />
                <label>Price</label>
                <input class="form-control" type="number" min="0" step="0.01" @bind="SelectedFile.Price" />
                <label>Description</label>
                <textarea class="form-control" maxlength="4000" rows="5" @bind="SelectedFile.Description"></textarea>
                <button class="btn btn-primary" @onclick="SaveFile">Save</button>
                <button class="btn btn-danger" @onclick="DeleteFile">Delete</button>
            </div>
        </div></div>
    </div>
}

@if (ConfirmDeletePopup)
{
    <div class="modal" tabindex="-1" style="display:block;background-color:gainsboro" role="dialog">
        <div class="modal-dialog"><div class="modal-content">
            <div class="modal-header"><h3 class="modal-title">Delete File?</h3></div>
            <div class="modal-body">
                <button class="btn btn-primary" @onclick="DeleteYes">Yes</button>
                <button class="btn btn-danger" @onclick="DeleteNo">No</button>
            </div>
        </div></div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    [SupplyParameterFromQuery] private int? Buy { get; set; }

    private bool UserIsAnAdmin;
    private bool UserIsLoggedIn;
    private bool LoadingFiles;
    private bool FileUploadPopup;
    private bool FileEditPopup;
    private bool ConfirmDeletePopup;
    private string ErrorMessage = "";
    private ApplicationUser CurrentApplicationUser;
    private ClaimsPrincipal CurrentUser;
    private FilesDTO SelectedFile = new();
    private int CurrentPage = 1;
    private StripeSettings StripeSettings = new();
    private FilesPaged colFiles = new() { Files = [], FilesCount = 0 };
    private IEnumerable<FilesDTO> OrderedFiles => Buy.HasValue
        ? colFiles.Files.OrderByDescending(x => int.TryParse(x.FileId, out var id) && id == Buy.Value)
        : colFiles.Files;
    private bool ShowPreviousButton => CurrentPage > 1;
    private bool ShowNextButton => colFiles.FilesCount > CurrentPage * 10;

    protected override async Task OnInitializedAsync()
    {
        LoadingFiles = true;
        CurrentUser = (await AuthenticationStateTask).User;
        UserIsLoggedIn = CurrentUser.Identity?.IsAuthenticated == true;
        UserIsAnAdmin = CurrentUser.IsInRole("Administrators");
        if (UserIsLoggedIn)
            CurrentApplicationUser = await UserManager.FindByNameAsync(CurrentUser.Identity.Name);

        StripeSettings = await ScopedServices.GetRequiredService<StripeSettingsService>().GetAsync();
        await GetFiles();
        DisqusState.SetDisplayDisqus(false);
        LoadingFiles = false;
    }

    private async Task GetFiles()
    {
        colFiles = await ScopedServices.GetRequiredService<BlogsService>().GetFilesAsync(CurrentPage);
        if (Buy.HasValue && !colFiles.Files.Any(x => x.FileId == Buy.Value.ToString(CultureInfo.InvariantCulture)))
        {
            var target = await ScopedServices.GetRequiredService<BlazorBlogsContext>().Files.AsNoTracking()
                .Where(x => x.FileId == Buy.Value)
                .Select(x => new FilesDTO
                {
                    FileId = x.FileId.ToString(),
                    FileName = x.FileName,
                    FilePath = x.FilePath,
                    OriginalFileName = x.OriginalFileName,
                    Price = x.Price,
                    CreateDate = x.CreateDate,
                    DownloadCount = x.DownloadCount,
                    Description = x.Description
                })
                .SingleOrDefaultAsync();
            if (target is not null)
                colFiles.Files.Insert(0, target);
        }
        var owned = await ScopedServices.GetRequiredService<PaidDownloadService>()
            .GetOwnedFileIdsAsync(CurrentApplicationUser);
        foreach (var file in colFiles.Files)
            file.Owned = int.TryParse(file.FileId, out var id) && owned.Contains(id);
    }

    private void UploadFile()
    {
        SelectedFile = new FilesDTO();
        FileUploadPopup = true;
    }

    private void CloseUploadPopup() => FileUploadPopup = false;
    private void EditFile(FilesDTO file)
    {
        SelectedFile = file;
        FileEditPopup = true;
    }

    private async Task SaveFile()
    {
        try
        {
            if ((SelectedFile.Description?.Length ?? 0) > 4000)
                throw new InvalidOperationException("Description cannot exceed 4000 characters.");

            await ScopedServices.GetRequiredService<BlogsService>().UpdateFilesAsync(SelectedFile);
            await GetFiles();
            FileEditPopup = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.GetBaseException().Message;
        }
    }

    private void DeleteFile() => ConfirmDeletePopup = true;
    private void DeleteNo() => ConfirmDeletePopup = false;
    private void ClosePopup() => FileEditPopup = false;

    private async Task DeleteYes()
    {
        try
        {
            var id = int.Parse(SelectedFile.FileId);
            var paid = ScopedServices.GetRequiredService<PaidDownloadService>();
            if (!await paid.CanDeleteFileAsync(id))
            {
                ErrorMessage = "This file has purchases and cannot be deleted.";
                return;
            }
            if (!await ScopedServices.GetRequiredService<BlogsService>().DeleteFilesAsync(SelectedFile))
                throw new InvalidOperationException("The download no longer exists.");
            ScopedServices.GetRequiredService<DownloadStorageService>().Delete(SelectedFile.FilePath);
            await LogAction($"{CurrentUser.Identity?.Name} deleted file {SelectedFile.FilePath}");
            await GetFiles();
            ConfirmDeletePopup = false;
            FileEditPopup = false;
            ErrorMessage = "";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.GetBaseException().Message;
            ToastService.ShowError(ErrorMessage);
        }
    }

    private async Task BuyFile(FilesDTO dto)
    {
        try
        {
            var id = int.Parse(dto.FileId);
            var context = ScopedServices.GetRequiredService<BlazorBlogsContext>();
            var file = await context.Files.SingleAsync(x => x.FileId == id);
            var checkout = await ScopedServices.GetRequiredService<PaidDownloadService>()
                .StartCheckoutAsync(file, CurrentApplicationUser, NavigationManager.BaseUri);
            NavigationManager.NavigateTo(checkout.Url, true);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.GetBaseException().Message;
            ToastService.ShowError("Payment is unavailable");
            await LogAction($"Paid download checkout failed: {ErrorMessage}");
        }
    }

    private async Task OnUploadComplete(UploadCompleteEventArgs args)
    {
        try
        {
            if (args.Cancelled)
                return;
            if ((SelectedFile.Description?.Length ?? 0) > 4000)
                throw new InvalidOperationException("Description cannot exceed 4000 characters.");

            using var response = System.Text.Json.JsonDocument.Parse(args.RawResponse);
            var fileId = response.RootElement.GetProperty("fileId").GetInt32();
            var context = ScopedServices.GetRequiredService<BlazorBlogsContext>();
            var file = await context.Files.SingleAsync(x => x.FileId == fileId);
            file.Description = SelectedFile.Description?.Trim() ?? "";
            await context.SaveChangesAsync();

            FileUploadPopup = false;
            await GetFiles();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.GetBaseException().Message;
            ToastService.ShowError(ErrorMessage);
        }
    }

    private void OnUploadError(UploadErrorEventArgs args)
    {
        ErrorMessage = args.Message;
        ToastService.ShowError(args.Message);
    }

    private async Task Previous()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            await GetFiles();
        }
    }

    private async Task Next()
    {
        CurrentPage++;
        await GetFiles();
    }

    private async Task LogAction(string action)
    {
        await ScopedServices.GetRequiredService<BlogsService>().CreateLogAsync(new BlazorBlogs.Data.Models.Logs
        {
            LogDate = DateTime.Now,
            LogAction = action,
            LogUserName = CurrentUser.Identity?.Name ?? "",
            LogIpaddress = HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString() ?? "127.0.0.1"
        });
    }
}
