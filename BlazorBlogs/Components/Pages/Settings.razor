@page "/settings"
@attribute [Authorize(Roles = "Administrators")]
@using System.Threading
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity;
@using BlazorBlogs.Data;
@using BlazorBlogs.Data.Models;
@using System.Net.Http
@using System.Net
@using System.Text.RegularExpressions
@inject UserManager<ApplicationUser> _UserManager
@inject RoleManager<IdentityRole> _RoleManager
@inject IConfiguration _configuration
@inject IToastService toastService
@inject EmailService _EmailService
@inject GeneralSettingsService _GeneralSettingsService
@inject IHttpContextAccessor httpContextAccessor
@inject DisqusState DisqusState
@inject GeneralSettingsState GeneralSettingsState
@inject HttpClient Http
@inject NavigationManager UriHelper
@inherits OwningComponentBase

@layout BlazorBlogs.Components.Layout.AdminLayout

<div class="bb-page-header">
    <div>
        <p class="bb-muted">Application settings</p>
        <h1>Settings</h1>
    </div>
    <div class="bb-page-actions">
        <button class="btn btn-secondary" type="button" @onclick="SendTestEmail">Send test email</button>
        <button class="btn btn-primary" type="button" @onclick="Save">Save changes</button>
    </div>
    <AuthorizeView Roles="Administrators">
        <Authorized>
            <section class="settings-card">
                <div class="bb-section-heading">
                    <div>
                        <h2>Database connection</h2>
                        <p>Source used to resolve the application database connection.</p>
                    </div>
                </div>
                <p><strong>@ConnectionStringStore.Status</strong></p>
                @if (ConnectionStringStore.Status == ConnectionSource.AppSettingsOnly)
                {
                    <div class="bb-alert bb-alert-warning" role="alert">
                        The database connection remains in appsettings.json because the local file could not be
                        created. @ConnectionStringStore.StatusReason Set the
                        <code>ConnectionStrings__DefaultConnection</code> environment variable before updating the site.
                    </div>
                }
            </section>
        </Authorized>
    </AuthorizeView>
</div>
<!-- AuthorizeView allows us to only show sections of the page -->
<!-- based on the security on the current user -->
<AuthorizeView>
    <!-- Show this section if the user is logged in -->
    <Authorized>
        @if (@context.User.IsInRole(ADMINISTRATION_ROLE))
        {
            <section class="settings-card">
                <div class="bb-section-heading">
                    <div>
                        <h2>General</h2>
                        <p>Core site identity, registration, email and analytics configuration.</p>
                    </div>
                    <span class="bb-badge">v@(objGeneralSettings.VersionNumber)</span>
                </div>
            <table class="table settings-table">
                <tbody>
                    <tr>
                        <td>Application Version: <b>@objGeneralSettings.VersionNumber</b></td>
                    </tr>
                    <tr>
                        <td>Application Name</td>
                        <td>
                            <input aria-label="Application name" class="form-control" type="text"
                                   @bind="objGeneralSettings.ApplicationName" />
                        </td>
                    </tr>
                    <tr>
                        <td><label for="site-base-url">Site base URL</label></td>
                        <td>
                            <input id="site-base-url" aria-label="Site base URL"
                                   class="form-control" type="url"
                                   placeholder="https://example.com/"
                                   @bind="objGeneralSettings.SiteBaseUrl" />
                            <small class="bb-muted">Used for Google, newsletter, Stripe and download links.</small>
                        </td>
                    </tr>
                    <tr>
                        <td><label for="theme-accent">Theme accent color</label></td>
                        <td>
                            <div class="bb-color-field">
                                <input id="theme-accent" class="form-control" type="color"
                                       @bind="objGeneralSettings.ThemeAccentColor"
                                       @bind:event="oninput" />
                                <input class="form-control" type="text"
                                       aria-label="Theme accent color hexadecimal value"
                                       pattern="^#[0-9A-Fa-f]{6}$"
                                       @bind="objGeneralSettings.ThemeAccentColor" />
                            </div>
                            <small class="bb-muted">Used for primary actions, the logo mark and progress.</small>
                        </td>
                    </tr>
                    <tr>
                        <td>Application Logo</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(objGeneralSettings.ApplicationLogo))
                            {
                                <img src="@objGeneralSettings.ApplicationLogo"
                                     alt="@objGeneralSettings.ApplicationName" />
                            }
                            <button type="button" class="btn btn-link" @onclick="SelectLogo">[Select]</button>
                            <button type="button" class="btn btn-link" @onclick="ClearLogo">[Clear]</button>
                        </td>
                    </tr>
                    <tr>
                        <td>Application Header</td>
                        <td>
                            <HtmlEditor @ref="ApplicationHeaderEditor"
                                        @bind-Value="objGeneralSettings.ApplicationHeader"
                                        InitialMode="@ApplicationHeaderEditorMode" />
                            <button type="button" class="btn btn-link" @onclick="TogglePreview">Preview</button>
                            @if (ShowApplicationHeaderPreview)
                            {
                                <div class="site-header">
                                    @((MarkupString)(objGeneralSettings.ApplicationHeader ?? ""))
                                </div>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td>Show Application Header</td>
                        <td>
                            <select aria-label="Show application header" class="form-control"
                                    @bind="objGeneralSettings.ApplicationHeaderEnabled">
                                <option value="true">True</option>
                                <option value="false">False</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>Allow Registration</td>
                        <td>
                            <select aria-label="Allow registration" class="form-control"
                                    @bind="@AllowRegistration">
                                @foreach (var option in OptionsTrueFalse)
                                {
                                    <option value="@option">
                                        @option
                                    </option>
                                }
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>Verified Registration</td>
                        <td>
                            <select aria-label="Verified registration" class="form-control"
                                    @bind="@VerifiedRegistration">
                                @foreach (var option in OptionsTrueFalse)
                                {
                                    <option value="@option">
                                        @option
                                    </option>
                                }
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>SMTP Server</td>
                        <td>
                            <input aria-label="SMTP server" class="form-control" type="text"
                                   @bind="objGeneralSettings.SMTPServer" />
                        </td>
                    </tr>
                    <tr>
                        <td>SMTP Authentication</td>
                        <td>
                            <select aria-label="SMTP authentication" class="form-control"
                                    @bind="@SMTPAuthentication">
                                @foreach (var option in OptionsSMTP)
                                {
                                    <option value="@option">
                                        @option
                                    </option>
                                }
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>SMTP Secure</td>
                        <td>
                            <select aria-label="SMTP secure" class="form-control"
                                    @bind="@SMTPSecure">
                                @foreach (var option in OptionsTrueFalse)
                                {
                                    <option value="@option">
                                        @option
                                    </option>
                                }
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>SMTP User Name</td>
                        <td>
                            <input aria-label="SMTP user name" class="form-control" type="text"
                                   @bind="objGeneralSettings.SMTPUserName" />
                        </td>
                    </tr>
                    <tr>
                        <td>SMTP Password</td>
                        <td>
                            <input aria-label="SMTP password" class="form-control" type="password"
                                   @bind="objGeneralSettings.SMTPPassword" />
                        </td>
                    </tr>
                    <tr>
                        <td>SMTP From Email</td>
                        <td>
                            <input aria-label="SMTP from email" class="form-control" type="email"
                                   @bind="objGeneralSettings.SMTPFromEmail" />
                        </td>
                    </tr>
                    <tr>
                        <td>Enable Disqus Comments</td>
                        <td>
                            <select aria-label="Enable Disqus comments" class="form-control"
                                    @bind="@DisqusEnabled">
                                @foreach (var option in OptionsTrueFalse)
                                {
                                    <option value="@option">
                                        @option
                                    </option>
                                }
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>Disqus ShortName</td>
                        <td>
                            <input aria-label="Disqus short name" class="form-control" type="text"
                                   @bind="objGeneralSettings.DisqusShortName" />
                        </td>
                    </tr>
                    <tr>
                        <td>Google Tracking ID</td>
                        <td>
                            <input aria-label="Google tracking ID" class="form-control" type="text"
                                   @bind="objGeneralSettings.GoogleTrackingID" />
                        </td>
                    </tr>
                </tbody>
            </table>
            </section>
            <br />
            <div class="bb-page-actions">
                <button class="btn btn-primary" @onclick="Save">Save changes</button>
                <button class="btn btn-secondary" @onclick="SendTestEmail">Send test email</button>
            </div>
            <br />
            <GoogleAuthSettingsPanel />
            <StripeSettingsPanel />
            <FileSelector @ref="FileManagerControl"
                         ImageSelected="InsertImage" />

        }
    </Authorized>
    <!-- Show this section if the user is not logged in -->
    <NotAuthorized>
        <p>You're not signed in.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    // AuthenticationState is available as a CascadingParameter
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    public System.Security.Claims.ClaimsPrincipal CurrentUser;
    string ADMINISTRATION_ROLE = "Administrators";

    GeneralSettings objGeneralSettings = new GeneralSettings();
    private FileSelector FileManagerControl;
    private HtmlEditor ApplicationHeaderEditor;
    private HtmlEditorMode ApplicationHeaderEditorMode;
    private bool ShowApplicationHeaderPreview;

    List<string> OptionsTrueFalse = new List<string>() { "True", "False" };
    List<string> OptionsSMTP = new List<string>() { "Anonymous", "Basic", "NTLM" };
    string AllowRegistration = "";
    string VerifiedRegistration = "";
    string SMTPSecure = "";
    string SMTPAuthentication = "";
    string DisqusEnabled = "";

    protected override async Task OnInitializedAsync()
    {
        // Get the current user
        CurrentUser = (await authenticationStateTask).User;

        _GeneralSettingsService = (GeneralSettingsService)ScopedServices.GetService(typeof(GeneralSettingsService));
        _EmailService = (EmailService)ScopedServices.GetService(typeof(EmailService));

        await LoadGeneralSettingsAsync();

        DisqusState.SetDisplayDisqus(false);
    }

    protected async Task LoadGeneralSettingsAsync()
    {
        objGeneralSettings = await _GeneralSettingsService.GetGeneralSettingsAsync();
        AllowRegistration = objGeneralSettings.AllowRegistration.ToString();
        VerifiedRegistration = objGeneralSettings.VerifiedRegistration.ToString();
        SMTPSecure = objGeneralSettings.SMTPSecure.ToString();
        DisqusEnabled = objGeneralSettings.DisqusEnabled.ToString();
        ApplicationHeaderEditorMode =
            string.Equals(objGeneralSettings.ApplicationHeaderEditorMode, "Raw", StringComparison.OrdinalIgnoreCase)
                ? HtmlEditorMode.Source
                : HtmlEditorMode.Design;

        switch (objGeneralSettings.SMTPAuthendication.Trim())
        {
            case "":
            case "0":
                SMTPAuthentication = "Anonymous";
                break;
            case "1":
                SMTPAuthentication = "Basic";
                break;
            case "2":
                SMTPAuthentication = "NTLM";
                break;
        }
    }

    void SelectLogo()
    {
        FileManagerControl.SetShowFileManager(true);
    }

    void InsertImage(string paramImageURL)
    {
        objGeneralSettings.ApplicationLogo = paramImageURL;

        FileManagerControl.SetShowFileManager(false);
    }

    void ClearLogo()
    {
        objGeneralSettings.ApplicationLogo = "";
    }

    private void TogglePreview() =>
        ShowApplicationHeaderPreview = !ShowApplicationHeaderPreview;

    public async Task Save()
    {
        try
        {
            await EnsureAdministratorAsync();
            await SaveSettings();
            toastService.ShowSuccess("Saved!");
        }
        catch (Exception ex)
        {
            toastService.ShowError(ex.GetBaseException().Message);
        }
    }

    public async Task SaveSettings()
    {
        await EnsureAdministratorAsync();
        var siteBaseUrl = (objGeneralSettings.SiteBaseUrl ?? "").Trim();
        if (!string.IsNullOrWhiteSpace(siteBaseUrl)
            && (!Uri.TryCreate(siteBaseUrl, UriKind.Absolute, out var parsedBaseUrl)
                || (parsedBaseUrl.Scheme != Uri.UriSchemeHttp
                    && parsedBaseUrl.Scheme != Uri.UriSchemeHttps)))
        {
            throw new InvalidOperationException("Site base URL must be an absolute http or https URL.");
        }

        objGeneralSettings.SiteBaseUrl = siteBaseUrl;
        await _GeneralSettingsService.UpdateAllowRegistrationAsync(Convert.ToBoolean(AllowRegistration));
        await _GeneralSettingsService.UpdateVerifiedRegistrationAsync(Convert.ToBoolean(VerifiedRegistration));
        await _GeneralSettingsService.UpdateSMTPSecureAsync(Convert.ToBoolean(SMTPSecure));

        await _GeneralSettingsService.UpdateApplicationNameAsync(objGeneralSettings.ApplicationName);
        await _GeneralSettingsService.UpdateApplicationLogoAsync(objGeneralSettings.ApplicationLogo);
        await _GeneralSettingsService.UpdateSMTPServerAsync(objGeneralSettings.SMTPServer);
        await _GeneralSettingsService.UpdateSMTPUserNameAsync(objGeneralSettings.SMTPUserName);
        await _GeneralSettingsService.UpdateSMTPPasswordAsync(objGeneralSettings.SMTPPassword);
        await _GeneralSettingsService.UpdateSMTPFromEmailAsync(objGeneralSettings.SMTPFromEmail);

        await _GeneralSettingsService.UpdateDisqusEnabledAsync(Convert.ToBoolean(DisqusEnabled));
        await _GeneralSettingsService.UpdateDisqusShortNameAsync(objGeneralSettings.DisqusShortName);

        await _GeneralSettingsService.UpdateGoogleTrackingIDAsync(objGeneralSettings.GoogleTrackingID);
        if (!Regex.IsMatch(objGeneralSettings.ThemeAccentColor ?? "", "^#[0-9A-Fa-f]{6}$"))
        {
            objGeneralSettings.ThemeAccentColor = ThemeDefaults.AccentColor;
        }
        await _GeneralSettingsService.SetSettingAsync(
            "ThemeAccentColor",
            objGeneralSettings.ThemeAccentColor);
        await _GeneralSettingsService.SetSettingAsync("SiteBaseUrl", objGeneralSettings.SiteBaseUrl);

        objGeneralSettings.ApplicationHeader ??= "";
        if (!HasContent(objGeneralSettings.ApplicationHeader))
        {
            objGeneralSettings.ApplicationHeader = "";
        }

        await _GeneralSettingsService.UpdateApplicationHeaderAsync(objGeneralSettings.ApplicationHeader);
        await _GeneralSettingsService.SetSettingAsync(
            "ApplicationHeaderEnabled",
            objGeneralSettings.ApplicationHeaderEnabled.ToString());

        ApplicationHeaderEditorMode = ApplicationHeaderEditor.GetMode();
        objGeneralSettings.ApplicationHeaderEditorMode =
            ApplicationHeaderEditorMode == HtmlEditorMode.Source ? "Raw" : "Rich";
        await _GeneralSettingsService.SetSettingAsync(
            "ApplicationHeaderEditorMode",
            objGeneralSettings.ApplicationHeaderEditorMode);

        switch (SMTPAuthentication)
        {
            case "Anonymous":
                objGeneralSettings.SMTPAuthendication = "0";
                break;
            case "Basic":
                objGeneralSettings.SMTPAuthendication = "1";
                break;
            case "NTLM":
                objGeneralSettings.SMTPAuthendication = "2";
                break;
        }

        await _GeneralSettingsService.UpdateSMTPAuthenticationAsync(objGeneralSettings.SMTPAuthendication);

        objGeneralSettings = await _GeneralSettingsService.GetGeneralSettingsAsync();
        GeneralSettingsState.NotifyChanged(objGeneralSettings);
    }

    private static bool HasContent(string html)
    {
        if (Regex.IsMatch(html, @"<img\b", RegexOptions.IgnoreCase))
        {
            return true;
        }

        var text = Regex.Replace(html ?? "", "<[^>]*>", "");
        text = Regex.Replace(text, "&nbsp;", "", RegexOptions.IgnoreCase);
        return !string.IsNullOrWhiteSpace(WebUtility.HtmlDecode(text));
    }

    public async Task SendTestEmail()
    {
        try
        {
            await EnsureAdministratorAsync();
            await SaveSettings();

            // Send Test Email
            string strError = await _EmailService.SendMailAsync(
                 false,
                 objGeneralSettings.SMTPFromEmail,
                 "Blazor-Blogs Administrator",
                 "", "",
                 objGeneralSettings.SMTPFromEmail,
                 "Blazor-Blogs SMTP Test Email",
                 $"This is a Blazor-Blogs SMTP Test Email from: { httpContextAccessor.HttpContext.Request.Scheme}://{httpContextAccessor.HttpContext.Request.Host}{httpContextAccessor.HttpContext.Request.PathBase}");

            if (strError == "")
            {
                toastService.ShowSuccess("Test Email Sent");
            }
            else
            {
                toastService.ShowError(strError);
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError(ex.GetBaseException().Message);
        }
    }

    private async Task EnsureAdministratorAsync()
    {
        var user = (await authenticationStateTask).User;
        if (user.Identity?.IsAuthenticated != true || !user.IsInRole(ADMINISTRATION_ROLE))
            throw new UnauthorizedAccessException("Administrator access is required.");
    }
}