@page "/downloads/resend"
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using BlazorBlogs.Data
@inject PaidDownloadService PaidDownloadService
@inject NavigationManager NavigationManager
@inject ILogger<DownloadResend> Logger

<section class="account-card">
<div class="bb-page-header">
    <div>
        <p class="bb-muted">Purchase recovery</p>
        <h1>Resend download links</h1>
    </div>
</div>
<p>Enter the email address used for the purchase. If paid guest downloads exist, new links will be sent.</p>
<EditForm Model="Model" FormName="download-resend" method="post" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <label for="resend-email">Email</label>
    <InputText id="resend-email" class="form-control" type="email" autocomplete="email" @bind-Value="Model.Email" />
    <ValidationMessage For="() => Model.Email" />
    <button class="btn btn-primary" type="submit">Send links</button>
</EditForm>
@if (Submitted)
{
    <div class="alert alert-info">If paid guest downloads exist for that address, new links will be sent.</div>
}
</section>

@code {
    [SupplyParameterFromForm] public ResendModel Model { get; set; }
    private bool Submitted;

    protected override void OnInitialized() => Model ??= new();

    private async Task Submit()
    {
        try
        {
            await PaidDownloadService.ResendAsync(Model.Email, NavigationManager.BaseUri);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not send a guest download recovery email.");
        }
        Submitted = true;
    }

    public sealed class ResendModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
    }
}
