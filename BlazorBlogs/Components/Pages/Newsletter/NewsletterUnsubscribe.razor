@page "/NewsletterUnsubscribe/{UserId}"
@attribute [ExcludeFromInteractiveRouting]
@using BlazorBlogs.Data
@inject NewsletterSubscriptionService Subscriptions
@inject NavigationManager NavigationManager

@if (NotFound)
{
    <PageTitle>Newsletter link not found</PageTitle>
    <h1>Newsletter link not found</h1>
    <p>This subscription link is no longer valid. You can manage your newsletter preference from your account page.</p>
    <a href="/Account/Manage/Newsletter">Manage newsletter preferences</a>
}

@code {
    [Parameter] public string UserId { get; set; }
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    private bool NotFound;

    protected override async Task OnInitializedAsync()
    {
        var token = await GetTokenAsync();
        if (NewsletterSubscriptionService.IsWellFormedToken(token))
        {
            HttpContext.Response.Redirect(
                $"/newsletter/preferences/{Uri.EscapeDataString(token)}");
            return;
        }

        NotFound = true;
    }

    private Task<string> GetTokenAsync() =>
        string.IsNullOrWhiteSpace(UserId)
            ? Task.FromResult<string>(null)
            : Subscriptions.GetExistingTokenAsync(UserId);
}
