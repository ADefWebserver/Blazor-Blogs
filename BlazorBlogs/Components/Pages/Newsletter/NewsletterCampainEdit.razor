@using BlazorBlogs.Data
@using BlazorBlogs.Data.Models
@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable
@inject BlogsService BlogsService
@inject GeneralSettingsService GeneralSettingsService
@inject NewsletterSubscriptionService Subscriptions
@inject CampaignSender CampaignSender
@inject CampaignSendRegistry SendRegistry
@inject SiteUrlService SiteUrlService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@if (ShowCampainEditPopup)
{
    <section class="campaign-panel bb-card" aria-labelledby="campaign-heading">
        <div class="bb-section-heading">
            <div>
                <p class="bb-muted">Campaign</p>
                <h2 id="campaign-heading">@SelectedNewslettersCampain.NewsletterCampainName</h2>
            </div>
            @if (!Sending)
            {
                <button type="button" class="btn btn-secondary" aria-label="Close campaign panel" @onclick="ClosePopup">Close</button>
            }
        </div>

                    @if (LocalhostWarning)
                    {
                        <div class="alert alert-warning">
                            The configured site address uses localhost. Newsletter links may not work for recipients.
                        </div>
                    }

                    @if (RegistryBusy)
                    {
                        <div class="alert alert-info">
                            This campaign is being sent from another window. @Remaining recipients remain.
                        </div>
                        <button class="btn btn-secondary" disabled="@Sending" @onclick="RefreshAsync">Refresh</button>
                    }
                    else if (Remaining == 0 && SentCount > 0)
                    {
                        <div class="alert alert-success">All @SentCount recipients have been sent this campaign.</div>
                    }
                    else
                    {
                        <p>
                            <b>@(SentCount > 0 ? "Remaining" : "Emails to send"):</b> @Remaining
                            @if (SentCount > 0)
                            {
                                <span> (@SentCount already sent)</span>
                            }
                        </p>
                    }

                    @if (Sending)
                    {
                        <div class="alert alert-info">
                            Keep this window open until sending finishes. If you are cut off, reopen this campaign and choose Resume.
                        </div>
                        <RadzenProgressBar Value="@Progress" Max="@Math.Max(RemainingAtStart, 1)" ShowValue="true" />
                        <p>Sent @RunSent, failed @RunFailed.</p>
                    }

                    @if (!RegistryBusy && Remaining > 0)
                    {
                        <button class="btn btn-danger" disabled="@Sending" @onclick="ProcessCampaignAsync">
                            @(SentCount > 0
                                ? $"Resume sending ({Remaining} remaining, {SentCount} already sent)"
                                : $"Send Campaign ({Remaining} recipients)")
                        </button>
                    }
                    @if (!RegistryBusy)
                    {
                        <span>&nbsp;&nbsp;</span>
                        <button class="btn btn-success" disabled="@Sending" @onclick="TestCampaignAsync">Send Test</button>
                    }

                    @if (Summary is not null)
                    {
                        <p>Sent @Summary.Sent, failed @Summary.Failed.</p>
                        @if (Summary.Failures.Count > 0)
                        {
                            <ul>
                                @foreach (var failure in Summary.Failures.Take(10))
                                {
                                    <li>@failure.Email: @failure.Error</li>
                                }
                            </ul>
                            @if (Summary.Failures.Count > 10)
                            {
                                <p>Additional failures are recorded in NewslettersLogs.</p>
                            }
                        }
                    }

                    <span style="color:red">@Error</span>
    </section>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; }
    [Parameter] public EventCallback<bool> SendingChanged { get; set; }

    private NewslettersCampain SelectedNewslettersCampain;
    private IReadOnlyList<NewsletterRecipient> Recipients = [];
    private CampaignSendSummary Summary;
    private CampaignSendRegistry.CampaignSendLease Lease;
    private CancellationTokenSource SendCancellation;
    private string Subject;
    private string Content;
    private string BaseUrl;
    private string Error;
    private bool ShowCampainEditPopup;
    private bool Sending;
    private bool RegistryBusy;
    private bool LocalhostWarning;
    private int SentCount;
    private int Remaining;
    private int RemainingAtStart;
    private int Progress;
    private int RunSent;
    private int RunFailed;

    public async Task EditNewslettersCampain(NewslettersCampain campaign)
    {
        SelectedNewslettersCampain = campaign;
        ShowCampainEditPopup = true;
        Error = "";
        Summary = null;
        BaseUrl = await SiteUrlService.GetBaseUrlAsync(NavigationManager.BaseUri);
        LocalhostWarning = Uri.TryCreate(BaseUrl, UriKind.Absolute, out var uri)
            && string.Equals(uri.Host, "localhost", StringComparison.OrdinalIgnoreCase);

        var contents = await BlogsService.GetNewslettersCampainEmailContentsAsync(campaign.Id);
        Subject = contents.Keys.FirstOrDefault() ?? "";
        Content = contents.Values.FirstOrDefault() ?? "";
        await RefreshAsync();
        StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        if (SelectedNewslettersCampain is null)
            return;
        Recipients = await Subscriptions.GetRecipientsAsync(SelectedNewslettersCampain.Id);
        SentCount = await Subscriptions.GetSentCountAsync(SelectedNewslettersCampain.Id);
        Remaining = Recipients.Count;
        RegistryBusy = SendRegistry.IsActive(SelectedNewslettersCampain.Id);
        StateHasChanged();
    }

    private void ClosePopup()
    {
        if (!Sending)
            ShowCampainEditPopup = false;
    }

    private async Task TestCampaignAsync()
    {
        if (Sending || SelectedNewslettersCampain is null)
            return;

        await SetSendingAsync(true);
        try
        {
            var settings = await GeneralSettingsService.GetGeneralSettingsAsync();
            var user = (await AuthenticationStateTask).User;
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            var token = await Subscriptions.EnsureTokenAsync(userId);
            if (string.IsNullOrWhiteSpace(userId)
                || string.IsNullOrWhiteSpace(token))
            {
                Error = "The administrator's newsletter token could not be loaded.";
                return;
            }

            var recipient = new NewsletterRecipient(
                userId,
                settings.SMTPFromEmail,
                token);
            var images = await CampaignSender.LoadImagesAsync(Content, BaseUrl);
            var result = await BlogsService.SendNewslettersCampainEmailAsync(
                recipient,
                SelectedNewslettersCampain,
                Subject,
                Content,
                images,
                settings.SMTPFromEmail,
                BaseUrl,
                logCampaign: false);
            Error = result.Succeeded ? "Test email sent." : result.Error;
        }
        finally
        {
            await SetSendingAsync(false);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ProcessCampaignAsync()
    {
        if (Sending || SelectedNewslettersCampain is null)
            return;

        Lease = SendRegistry.TryBegin(SelectedNewslettersCampain.Id);
        if (Lease is null)
        {
            await RefreshAsync();
            return;
        }

        SendCancellation = new CancellationTokenSource();
        RemainingAtStart = Recipients.Count;
        Progress = 0;
        RunSent = 0;
        RunFailed = 0;
        var campaign = SelectedNewslettersCampain;
        var recipients = Recipients.ToList();
        var subject = Subject;
        var content = Content;
        var baseUrl = BaseUrl;
        var settings = await GeneralSettingsService.GetGeneralSettingsAsync();

        await SetSendingAsync(true);
        try
        {
            Summary = await CampaignSender.SendAsync(
                campaign,
                recipients,
                subject,
                content,
                settings.SMTPFromEmail,
                baseUrl,
                async (sent, failed) =>
                {
                    Progress = sent + failed;
                    RunSent = sent;
                    RunFailed = failed;
                    await InvokeAsync(StateHasChanged);
                },
                SendCancellation.Token);
            RunSent = Summary.Sent;
            RunFailed = Summary.Failed;
        }
        catch (OperationCanceledException)
        {
            Summary = new CampaignSendSummary(RunSent, RunFailed, true, []);
        }
        finally
        {
            Lease.Dispose();
            Lease = null;
            SendCancellation.Dispose();
            SendCancellation = null;
            await SetSendingAsync(false);
            await RefreshAsync();
        }
    }

    private async Task SetSendingAsync(bool value)
    {
        Sending = value;
        await SendingChanged.InvokeAsync(value);
        try
        {
            await JS.InvokeVoidAsync("newsletterLeaveWarning", value);
        }
        catch
        {
            // The prompt cannot be attached during server prerendering/disposal.
        }
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        SendCancellation?.Cancel();
        SendCancellation?.Dispose();
        Lease?.Dispose();
        if (Sending)
        {
            try
            {
                await JS.InvokeVoidAsync("newsletterLeaveWarning", false);
            }
            catch
            {
                // The circuit or browser may already be gone.
            }
        }
    }
}
