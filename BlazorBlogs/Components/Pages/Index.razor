@page "/"
@using BlazorBlogs.Components.Layout
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity;
@using BlazorBlogs.Data;
@using BlazorBlogs.Data.Models;
@using static Toolbelt.Blazor.HeadElement.MetaElement
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> _UserManager
@inject SearchState SearchState
@inject InstallUpdateState _InstallUpdateState
@inject IConfiguration _configuration
@inject IHttpContextAccessor httpContextAccessor
@inject IHeadElementHelper HeadElementHelper
@inject DisqusState DisqusState
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inherits OwningComponentBase<BlogsService>
<PageTitle>Blazor-Blogs</PageTitle>
<Meta Property="og:title" Content="Blazor-Blogs" />
<div class="bb-page-header home-heading">
    <div>
        <p class="bb-muted">Latest stories and updates</p>
        <h1>From the blog</h1>
    </div>
    @if (UserIsAnAdmin)
    {
        <button type="button" class="btn btn-primary" @onclick="NewBlog">Write a post</button>
    }
</div>

<section class="home-toolbar" aria-label="Post filters">
    <label>
        <span class="visually-hidden">Filter by category</span>
        <RadzenDropDown AllowClear="true"
                        AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        @bind-Value="SearchState.CurrentCategoryID" Multiple="false"
                        Placeholder="All categories"
                        Data="@colCategorys" TextProperty="Title"
                        ValueProperty="CategoryId"
                        Change="@(args => ChangeCategory(args, "DropDown"))" />
    </label>
    <label class="home-search">
        <span class="visually-hidden">Search posts</span>
        <RadzenTextBox @bind-Value="SearchText" Placeholder="Search posts" />
    </label>
    <RadzenButton Text="Search" ButtonStyle="ButtonStyle.Primary" Click="@(args => Search())" />
</section>

<div class="home-layout">
    <main class="post-grid" aria-label="Blog posts">
        @foreach (var blog in colBlogs.Blogs)
        {
            <article class="post-card bb-card">
                <div class="bb-meta">@blog.BlogDate.ToString("MMMM d, yyyy")</div>
                <h2><a href="ViewBlogPost/@blog.BlogId">@blog.BlogTitle</a></h2>
                <div class="post-summary">@((MarkupString)blog.BlogSummary)</div>
                <a class="post-read-link" href="ViewBlogPost/@blog.BlogId" aria-label="@($"Read {blog.BlogTitle}")">
                    Read more <span aria-hidden="true">→</span>
                </a>
            </article>
        }
    </main>
    <aside class="home-sidebar">
        <section class="bb-card newsletter-prompt">
            <span class="bb-badge">Newsletter</span>
            <h2>Stay in the loop</h2>
            <p>Sign in to manage email updates and follow new posts.</p>
            <a class="btn btn-primary" href="Account/Manage/Newsletter">Manage subscription</a>
        </section>
        <section class="bb-card">
            <h2>Categories</h2>
            <div class="category-list">
                @foreach (var category in colCategorys)
                {
                    <button type="button" @onclick="@(() => ChangeCategory(category.CategoryId, "Category"))">
                        @category.Title
                    </button>
                }
            </div>
        </section>
    </aside>
</div>

<BlogAdministration @ref="BlogAdministrationControl" BlogUpdated="BlogUpdatedEvent" />
<LicenseTerms @ref="LicenseTermsControl" />
@if (!LoadingBlogs)
{
    <nav class="pager" aria-label="Post pages">
        <button class="btn btn-secondary" disabled="@(!ShowPreviousButton)" @onclick="Previous">← Newer</button>
        <button class="btn btn-secondary" disabled="@(!ShowNextButton)" @onclick="Next">Older →</button>
    </nav>
}
else
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="margin-bottom: 20px" />
}
<div class="legal-links">
    <button class="btn btn-link"
            @onclick="showTermsOfUse">
        Terms Of Use
    </button> |
    <button class="btn btn-link"
            @onclick="showPrivacyStatement">
        Privacy Statement
    </button>
</div>
@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    BlogAdministration BlogAdministrationControl;
    LicenseTerms LicenseTermsControl;
    bool LoadingBlogs = false;
    string SearchText = "";
    string ADMINISTRATION_ROLE = "Administrators";
    List<CategoryDTO> colCategorys = new List<CategoryDTO>();

    BlogsPaged colBlogs =
        new BlogsPaged()
            {
                Blogs = new List<Blogs>(),
                BlogCount = 0
            };

    bool ShowPreviousButton
    {
        get
        {
            return (SearchState.CurrentPage > 1);
        }
    }

    bool ShowNextButton
    {
        get
        {
            return (
                (colBlogs.BlogCount > (SearchState.CurrentPage * 5))
                );
        }
    }

    bool UserIsAnAdmin = false;
    System.Security.Claims.ClaimsPrincipal CurrentUser;

    protected override async Task OnInitializedAsync()
    {
        if (SearchState.CurrentPage == 0)
        {
            SearchState.CurrentPage = 1;
        }

        if (SearchState.CurrentCategoryID == null)
        {
            SearchState.CurrentCategoryID = "0";
        }

        LoadingBlogs = true;
        StateHasChanged();

        // Get the current user
        CurrentUser = (await authenticationStateTask).User;

        if (CurrentUser.Identity.IsAuthenticated)
        {
            var Current_User = await _UserManager.FindByNameAsync(CurrentUser.Identity.Name);

            UserIsAnAdmin = await _UserManager.IsInRoleAsync(Current_User, ADMINISTRATION_ROLE);
        }

        colCategorys = await @Service.GetCategorysAsync();

        // We access BlogsService using @Service
        colBlogs = await @Service.GetBlogsAsync(SearchState.CurrentPage, Convert.ToInt32(SearchState.CurrentCategoryID));

        DisqusState.SetDisplayDisqus(false);

        LoadingBlogs = false;
        StateHasChanged();
    }

    void NewBlog()
    {
        BlogAdministrationControl.AddNewBlog();
    }

    async Task BlogUpdatedEvent()
    {
        LoadingBlogs = true;
        StateHasChanged();

        colBlogs = await @Service.GetBlogsAsync(SearchState.CurrentPage, Convert.ToInt32(SearchState.CurrentCategoryID));

        LoadingBlogs = false;
        StateHasChanged();
    }

    async Task ChangeCategory(object value, string name)
    {
        LoadingBlogs = true;
        StateHasChanged();

        SearchState.CurrentPage = 1;
        SearchState.CurrentCategoryID = (value == null) ? "0" : value.ToString();

        colBlogs = await @Service.GetBlogsAsync(SearchState.CurrentPage, Convert.ToInt32(SearchState.CurrentCategoryID));

        LoadingBlogs = false;
        StateHasChanged();
    }

    void showTermsOfUse()
    {
        LicenseTermsControl.OpenPopup("TermsOfUse");
    }

    void showPrivacyStatement()
    {
        LicenseTermsControl.OpenPopup("PrivacyStatement");
    }

    async Task Previous()
    {
        LoadingBlogs = true;
        StateHasChanged();

        if (SearchState.CurrentPage > 1)
        {
            SearchState.CurrentPage = SearchState.CurrentPage - 1;
            colBlogs = await @Service.GetBlogsAsync(SearchState.CurrentPage, Convert.ToInt32(SearchState.CurrentCategoryID));
        }

        LoadingBlogs = false;
        StateHasChanged();
    }

    async Task Next()
    {
        LoadingBlogs = true;
        StateHasChanged();

        SearchState.CurrentPage = SearchState.CurrentPage + 1;
        colBlogs = await @Service.GetBlogsAsync(SearchState.CurrentPage, Convert.ToInt32(SearchState.CurrentCategoryID));

        LoadingBlogs = false;
        StateHasChanged();
    }

    private async Task Search()
    {
        // get the url of the current site
        var uri = new Uri(NavigationManager.Uri);
        SearchText = SearchText + $" site:{uri.DnsSafeHost}";
        // redirect user to google search
        await JSRuntime.InvokeVoidAsync("window.open", "https://www.google.com/search?q=" + SearchText, "_self");
    }
}