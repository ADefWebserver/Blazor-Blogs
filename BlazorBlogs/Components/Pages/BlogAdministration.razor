@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity;
@using BlazorBlogs.Data;
@using BlazorBlogs.Data.Models;
@inject UserManager<ApplicationUser> _UserManager
@inject RoleManager<IdentityRole> _RoleManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IHttpContextAccessor httpContextAccessor
@inject IConfiguration _configuration
@inherits OwningComponentBase<BlogsService>

@if (ShowAdmin)
{
    <div class="modal" tabindex="-1" style="display:block;background-color:gainsboro" role="dialog">
        <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title">Edit Blog</h3>
                    <!-- Button to close the popup -->
                    <button type="button" class="close"
                            @onclick="ClosePopup">
                        <span aria-hidden="true">X</span>
                    </button>
                </div>
                <!-- Edit form for the current Blog -->
                <div class="modal-body">
                    <div class="form-group">
                        <input class="form-control" type="date"
                               @bind="SelectedBlog.BlogDate" />
                    </div>
                    <h5>Title</h5>
                    <div class="form-group">
                        <input class="form-control" type="text"
                               @bind="SelectedBlog.BlogTitle" />
                    </div>
                    <h5>Summary</h5>
                    <div class="form-group">
                        <HtmlEditor @bind-Value="SelectedBlog.BlogSummary" />
                    </div>
                    <h5>Content</h5>
                    <div class="form-group">
                        <HtmlEditor @bind-Value="SelectedBlog.BlogContent" />
                    </div>
                    <br />
                    <!-- Button to save the user -->
                    <button class="btn btn-primary"
                            @onclick="SaveBlog">
                        Save
                    </button>&nbsp;
                    <!-- Only show delete button if not a new record -->
                    @if (SelectedBlog.BlogId.ToString() != "0")
                    {
                        <!-- Button to delete the Blog -->
                        <button class="btn btn-danger"
                                @onclick="DeleteBlog">
                            Delete
                        </button>
                    }
                    <br />
                    <span style="color:red">@strError</span>
                </div>
            </div>
        </div>
    </div>

    @if (ConFirmDeletePopup)
    {
        <div class="modal" tabindex="-1" style="display:block;background-color:gainsboro" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3 class="modal-title">Delete Blog Post?</h3>
                    </div>
                    <div class="modal-body">
                        <button class="btn btn-primary"
                                @onclick="DeleteYes">
                            Yes
                        </button>
                        <button class="btn btn-danger"
                                @onclick="DeleteNo">
                            No
                        </button>
                        <br />
                        <span style="color: red">@strError</span>
                    </div>
                </div>
            </div>
        </div>
    }

}

@code {
    // AuthenticationState is available as a CascadingParameter
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    [Parameter] public EventCallback<bool> BlogUpdated { get; set; }

    BlogDTO SelectedBlog;
    public bool ShowAdmin = false;
    public bool ConFirmDeletePopup = false;

    public System.Security.Claims.ClaimsPrincipal CurrentUser;

    string strError;

    protected override async Task OnInitializedAsync()
    {
        // Get the current user
        CurrentUser = (await authenticationStateTask).User;
    }   

    async Task ClosePopup()
    {
        // Close the Popup
        ShowAdmin = false;

        // Refresh collection on parent
        await BlogUpdated.InvokeAsync(true);
    }

    public async Task AddNewBlog()
    {
        if (!await IsAdministratorAsync())
        {
            return;
        }

        // Make new Blog
        SelectedBlog = new BlogDTO();
        // Set the default date
        SelectedBlog.BlogDate = DateTime.Now;
        // Set Id to 0 so we know it is a new record
        SelectedBlog.BlogId = 0;

        // Clear any error messages
        strError = "";
        // Open the Popup
        ShowAdmin = true;
        StateHasChanged();
    }

    public async Task EditBlog(BlogDTO Blog)
    {
        if (!await CanManageBlogAsync(Blog))
        {
            return;
        }

        // Set the selected Blog
        // as the current Blog
        SelectedBlog = Blog;

        // Clear any error messages
        strError = "";

        // Open the Popup
        ShowAdmin = true;
        StateHasChanged();
    }

    async Task SaveBlog()
    {
        try
        {
            if (SelectedBlog is null || !await CanManageBlogAsync(SelectedBlog))
            {
                strError = "You are not authorized to save this post.";
                return;
            }

            // A new Blog will have the Id set to 0
            if (SelectedBlog.BlogId == 0)
            {
                // Create new Blog
                BlogDTO objNewBlog = new BlogDTO();

                objNewBlog.BlogDate =
                    SelectedBlog.BlogDate;

                objNewBlog.BlogTitle =
                    SelectedBlog.BlogTitle;

                objNewBlog.BlogSummary = SelectedBlog.BlogSummary ?? "";
                objNewBlog.BlogContent = SelectedBlog.BlogContent ?? "";

                objNewBlog.BlogUserName =
                    CurrentUser.Identity.Name;

                // Save the result
                await Service.CreateBlogAsync(objNewBlog);

                // Log
                await LogAction($"Create Blog #{objNewBlog.BlogId}");
            }
            else
            {
                SelectedBlog.BlogSummary ??= "";
                SelectedBlog.BlogContent ??= "";

                await Service.UpdateBlogAsync(SelectedBlog);

                // Log
                await LogAction($"Update Blog #{SelectedBlog.BlogId}");
            }

            await ClosePopup();
        }
        catch (Exception ex)
        {
            strError = ex.GetBaseException().Message;
        }
    }

    void DeleteBlog()
    {
        ConFirmDeletePopup = true;
    }

    void DeleteNo()
    {
        ConFirmDeletePopup = false;
    }

    async Task DeleteYes()
    {
        try
        {
            if (SelectedBlog is null || !await CanManageBlogAsync(SelectedBlog))
            {
                strError = "You are not authorized to delete this post.";
                return;
            }

            int BlogId = SelectedBlog.BlogId;

            // Delete the Blog
            await Service.DeleteBlogAsync(SelectedBlog);

            // Log
            await LogAction($"Delete Blog #{BlogId}");

            await ClosePopup();
        }
        catch (Exception ex)
        {
            strError = ex.GetBaseException().Message;
        }
    }

    private async Task<bool> CanManageBlogAsync(BlogDTO blog)
    {
        if (await IsAdministratorAsync())
        {
            return true;
        }

        var userName = (await authenticationStateTask).User.Identity?.Name;
        return blog.BlogId != 0 &&
            !string.IsNullOrWhiteSpace(userName) &&
            string.Equals(blog.BlogUserName, userName, StringComparison.OrdinalIgnoreCase);
    }

    private async Task<bool> IsAdministratorAsync()
    {
        var userName = (await authenticationStateTask).User.Identity?.Name;
        if (string.IsNullOrWhiteSpace(userName))
        {
            return false;
        }

        var user = await _UserManager.FindByNameAsync(userName);
        return user is not null &&
            await _UserManager.IsInRoleAsync(user, "Administrators");
    }

    private async Task LogAction(string strAction)
    {
        // Get the current user
        var CurrentUser = (await authenticationStateTask).User;

        BlazorBlogs.Data.Models.Logs objLog = new BlazorBlogs.Data.Models.Logs();
        objLog.LogDate = DateTime.Now;
        objLog.LogAction = strAction;
        objLog.LogUserName = (CurrentUser.Identity != null) ? CurrentUser.Identity.Name : "";
        try
        {
            objLog.LogIpaddress = httpContextAccessor.HttpContext.Connection?.RemoteIpAddress.ToString();
        }
        catch
        {
            objLog.LogIpaddress = "127.0.0.1";
        }

        var result = await @Service.CreateLogAsync(objLog);
    }
}
