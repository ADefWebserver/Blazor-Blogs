@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authentication.Google
@using BlazorBlogs.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject ExternalAuthOptionsStore ExternalAuthOptionsStore

@if (ExternalAuthOptionsStore.IsGoogleConfigured && googleLogin is not null)
{
    <form class="form-horizontal" action="Account/PerformExternalLogin" method="post">
        <div>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <p>
                <button type="submit"
                        class="btn btn-primary"
                        name="provider"
                        value="@googleLogin.Name"
                        title="Log in using your @googleLogin.DisplayName account">@googleLogin.DisplayName</button>
            </p>
        </div>
    </form>
}

@code {
    private AuthenticationScheme googleLogin;

    [Parameter]
    public string ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        googleLogin = (await SignInManager.GetExternalAuthenticationSchemesAsync())
            .FirstOrDefault(x => x.Name == GoogleDefaults.AuthenticationScheme);
    }
}
