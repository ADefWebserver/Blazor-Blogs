@page "/Account/ExternalLogin"

@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using BlazorBlogs.Data
@using Microsoft.EntityFrameworkCore

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ExternalLogin> Logger
@inject GeneralSettingsService GeneralSettingsService

<PageTitle>External login</PageTitle>

<h1>Completing Google sign-in</h1>
<p>Please wait while your account is checked.</p>

@code {
    public const string LoginCallbackAction = "LoginCallback";

    private ExternalLoginInfo externalLoginInfo;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string Action { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (RemoteError is not null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", $"Error from external provider: {RemoteError}", HttpContext);
        }

        var info = await SignInManager.GetExternalLoginInfoAsync();
        if (info is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", "Error loading external login information.", HttpContext);
        }

        externalLoginInfo = info;

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (Action == LoginCallbackAction)
            {
                await OnLoginCallbackAsync();
                return;
            }

            // We should only reach this page via the login callback, so redirect back to
            // the login page if we get here some other way.
            RedirectManager.RedirectTo("Account/Login");
        }
    }

    private async Task OnLoginCallbackAsync()
    {
        if (externalLoginInfo is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", "Error loading external login information.", HttpContext);
        }

        // Sign in the user with this external login provider if the user already has a login.
        var result = await SignInManager.ExternalLoginSignInAsync(
            externalLoginInfo.LoginProvider,
            externalLoginInfo.ProviderKey,
            isPersistent: false,
            bypassTwoFactor: true);

        if (result.Succeeded)
        {
            Logger.LogInformation(
                "{Name} logged in with {LoginProvider} provider.",
                externalLoginInfo.Principal.Identity?.Name,
                externalLoginInfo.LoginProvider);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else if (result.IsNotAllowed)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login",
                "This account is not confirmed or is locked.",
                HttpContext);
        }

        var email = externalLoginInfo.Principal.FindFirstValue(ClaimTypes.Email)?.Trim();
        var verifiedValue = externalLoginInfo.Principal
            .FindFirstValue(ExternalAuthOptionsStore.GoogleEmailVerifiedClaim);
        if (string.IsNullOrWhiteSpace(email) ||
            !bool.TryParse(verifiedValue, out var emailVerified) ||
            !emailVerified)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login",
                "Google did not confirm your email address.",
                HttpContext);
        }

        var normalizedEmail = UserManager.NormalizeEmail(email);
        var matchingUsers = await UserManager.Users
            .Where(x => x.NormalizedEmail == normalizedEmail)
            .Take(2)
            .ToListAsync();

        if (matchingUsers.Count > 1)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login",
                "More than one account uses this email address. Contact the administrator.",
                HttpContext);
        }

        if (matchingUsers.Count == 1)
        {
            var existingUser = matchingUsers[0];
            if (!existingUser.EmailConfirmed || await UserManager.IsLockedOutAsync(existingUser))
            {
                RedirectManager.RedirectToWithStatus(
                    "Account/Login",
                    "This account is not confirmed or is locked.",
                    HttpContext);
            }

            var existingLinkResult = await UserManager.AddLoginAsync(existingUser, externalLoginInfo);
            if (!existingLinkResult.Succeeded)
            {
                RedirectWithIdentityErrors(existingLinkResult);
            }

            Logger.LogInformation(
                "Existing account linked to {LoginProvider} provider.",
                externalLoginInfo.LoginProvider);
            await SignInManager.SignInAsync(existingUser, isPersistent: false, externalLoginInfo.LoginProvider);
            RedirectManager.RedirectTo(ReturnUrl);
        }

        if (!await IsRegistrationAllowedAsync())
        {
            RedirectManager.RedirectToWithStatus("Account/Login", "Registration is closed", HttpContext);
        }

        var user = CreateUser();
        var emailStore = GetEmailStore();
        user.DisplayName = externalLoginInfo.Principal.FindFirstValue(ClaimTypes.Name) ?? "";
        user.EmailConfirmed = true;
        user.NewsletterSubscriber = false;

        await UserStore.SetUserNameAsync(user, email, CancellationToken.None);
        await emailStore.SetEmailAsync(user, email, CancellationToken.None);

        var createResult = await UserManager.CreateAsync(user);
        if (!createResult.Succeeded)
        {
            RedirectWithIdentityErrors(createResult);
        }

        var addLoginResult = await UserManager.AddLoginAsync(user, externalLoginInfo);
        if (!addLoginResult.Succeeded)
        {
            await UserManager.DeleteAsync(user);
            RedirectWithIdentityErrors(addLoginResult);
        }

        Logger.LogInformation(
            "User created an account using {LoginProvider} provider.",
            externalLoginInfo.LoginProvider);
        await SignInManager.SignInAsync(user, isPersistent: false, externalLoginInfo.LoginProvider);
        RedirectManager.RedirectTo(ReturnUrl);
    }

    private async Task<bool> IsRegistrationAllowedAsync()
    {
        return bool.TryParse(
                await GeneralSettingsService.GetSettingAsync("AllowRegistration"),
                out var allowed)
            && allowed;
    }

    private void RedirectWithIdentityErrors(IdentityResult result)
    {
        RedirectManager.RedirectToWithStatus(
            "Account/Login",
            string.Join(", ", result.Errors.Select(error => error.Description)),
            HttpContext);
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class and has a parameterless constructor");
        }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException("The default UI requires a user store with email support.");
        }
        return (IUserEmailStore<ApplicationUser>)UserStore;
    }
}
