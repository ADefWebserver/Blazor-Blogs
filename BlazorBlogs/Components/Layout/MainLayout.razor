@inherits LayoutComponentBase
@implements IDisposable
@using BlazorBlogs.Data;
@using BlazorBlogs.Data.Models;
@using Microsoft.EntityFrameworkCore;
@using System.Net;
@using System.Text.RegularExpressions;
@inject IConfiguration _configuration
@inject IJSRuntime JSRuntime
@inject BlogsService _BlogsService
@inject GeneralSettingsState GeneralSettingsState
@inject DisqusState DisqusState
@inject InstallUpdateState _InstallUpdateState
@inject NavigationManager NavigationManager
@inject IServiceScopeFactory ServiceScopeFactory

<PageTitle>Blazor-Blogs</PageTitle>
<RadzenComponents @rendermode="InteractiveServer" />
<BlazoredToasts />
@if (ready)
{
    <div class="bb-app" style="--bb-accent: @SafeAccentColor">
        <TopBar ApplicationName="@objGeneralSettings.ApplicationName"
                ApplicationLogo="@objGeneralSettings.ApplicationLogo" />
        <main class="bb-public-main">
            @if (objGeneralSettings.ApplicationHeaderEnabled
                && HasApplicationHeaderContent(objGeneralSettings.ApplicationHeader))
            {
                <div class="site-header">
                    @((MarkupString)objGeneralSettings.ApplicationHeader)
                </div>
            }
            <article @ref="@disqusBody" class="bb-page-content @(IsAccountPage ? "bb-account-page" : null)">
                @Body
                @if (Convert.ToBoolean(objGeneralSettings.DisqusEnabled))
                {
                    <div id="disqus_thread" style="@((!DisqusState.getDisplayDisqus()) ? "display: none;" : "")"></div>
                }
            </article>
        </main>
        <footer class="bb-footer">
            <span>&copy; @DateTime.UtcNow.Year @objGeneralSettings.ApplicationName</span>
            <a href="api/RSSFeed/Rss" aria-label="RSS feed">RSS</a>
            <a href="https://github.com/ADefWebserver/Blazor-Blogs" target="_blank" rel="noreferrer">About</a>
        </footer>
    </div>

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
}

@code {
    // ********************************
    const string CurrentVersion = "10.06.00";
    // ********************************

    GeneralSettings objGeneralSettings = new GeneralSettings();
    private ElementReference disqusBody;
    private bool ready;
    private bool IsAccountPage =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .StartsWith("Account/", StringComparison.OrdinalIgnoreCase);
    private string SafeAccentColor =>
        Regex.IsMatch(objGeneralSettings.ThemeAccentColor ?? "", "^#[0-9A-Fa-f]{6}$")
            ? objGeneralSettings.ThemeAccentColor
            : ThemeDefaults.AccentColor;

    protected override async Task OnInitializedAsync()
    {
        var connectionString = _configuration.GetConnectionString("DefaultConnection") ?? "";
        string redirectTo = null;
        var settingsLoaded = false;

        try
        {
            var optionsBuilder = new DbContextOptionsBuilder<BlazorBlogsContext>();
            BlazorBlogsDbOptions.Configure(optionsBuilder, connectionString, _configuration, retry: false);
            await using var probe = new BlazorBlogsContext(optionsBuilder.Options);

            if (!await probe.Database.CanConnectAsync())
            {
                redirectTo = "installwizard/INSTALL";
            }
        }
        catch
        {
            redirectTo = "installwizard/INSTALL";
        }

        if (redirectTo is not null)
        {
            NavigationManager.NavigateTo(redirectTo, true);
            return;
        }

        try
        {
            if (!await _BlogsService.IsDatabaseSetUpAsync(connectionString))
            {
                redirectTo = "installwizard/RUNSCRIPTS";
            }
        }
        catch
        {
            redirectTo = "installwizard/INSTALL";
        }

        if (redirectTo is not null)
        {
            NavigationManager.NavigateTo(redirectTo, true);
            return;
        }

        try
        {
            if (!await _BlogsService.AdminExistsAsync(connectionString))
            {
                redirectTo = "installwizard/CreateAdministrator";
            }
        }
        catch
        {
            redirectTo = "installwizard/INSTALL";
        }

        if (redirectTo is not null)
        {
            NavigationManager.NavigateTo(redirectTo, true);
            return;
        }

        try
        {
            using var scope = ServiceScopeFactory.CreateScope();
            var settingsService = scope.ServiceProvider.GetRequiredService<GeneralSettingsService>();
            objGeneralSettings = await settingsService.GetGeneralSettingsAsync();
            settingsLoaded = true;
        }
        catch
        {
            objGeneralSettings = new GeneralSettings();
        }

        GeneralSettingsState.NotifyChanged(objGeneralSettings);

        if (settingsLoaded && !IsAccountPage && IsNewer(CurrentVersion, objGeneralSettings.VersionNumber))
        {
            NavigationManager.NavigateTo("installwizard/UPGRADE", true);
            return;
        }

        ready = true;
        GeneralSettingsState.StateChanged += OnGeneralSettingsStateChanged;
    }

    private static bool HasApplicationHeaderContent(string html)
    {
        if (string.IsNullOrWhiteSpace(html))
        {
            return false;
        }

        if (Regex.IsMatch(html, @"<img\b", RegexOptions.IgnoreCase))
        {
            return true;
        }

        var text = Regex.Replace(html, "<[^>]*>", "");
        text = Regex.Replace(text, "&nbsp;", "", RegexOptions.IgnoreCase);
        return !string.IsNullOrWhiteSpace(WebUtility.HtmlDecode(text));
    }

    protected override async Task
         OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (Convert.ToBoolean(objGeneralSettings.DisqusEnabled))
            {
                await DisqusInterop.CreateDisqus(
                    JSRuntime,
                    disqusBody,
                    @$"https://{objGeneralSettings.DisqusShortName.Trim()}.disqus.com/embed.js");

                // Subscribe to the StateChanged EventHandler
                DisqusState.StateChanged +=
                OnDisqusStateStateChanged;

                StateHasChanged();
            }
        }
    }

    private void OnGeneralSettingsStateChanged(object sender, EventArgs args)
    {
        objGeneralSettings = GeneralSettingsState.Current;
        InvokeAsync(StateHasChanged);
    }

    private static bool IsNewer(string currentVersion, string databaseVersion)
    {
        return ConvertToInteger(currentVersion) > ConvertToInteger(databaseVersion);
    }

    private static int ConvertToInteger(string strParamVersion)
    {
        int intVersionNumber = 0;
        string strVersion = strParamVersion ?? "";

        if (string.IsNullOrWhiteSpace(strVersion))
        {
            return 0;
        }

        // Split into parts seperated by periods
        char[] splitchar = { '.' };
        var strSegments = strVersion.Split(splitchar);

        // Process the segments
        int i = 0;
        List<int> colMultiplyers = new List<int> { 10000, 100, 1 };
        foreach (var strSegment in strSegments)
        {
            int intSegmentNumber = Convert.ToInt32(strSegment);
            intVersionNumber = intVersionNumber + (intSegmentNumber * colMultiplyers[i]);
            i++;
        }

        return intVersionNumber;
    }
    void OnDisqusStateStateChanged(
        object sender, EventArgs e) => StateHasChanged();

    void IDisposable.Dispose()
    {
        GeneralSettingsState.StateChanged -= OnGeneralSettingsStateChanged;

        if (DisqusState != null)
        {
            // When this control is disposed of
            // unsubscribe from the StateChanged EventHandler
            DisqusState.StateChanged -=
            OnDisqusStateStateChanged;
        }
    }
}