@using BlazorBlogs.Data
@using BlazorBlogs.Data.Models

<header class="bb-topbar">
    <a class="bb-brand" href="/" aria-label="@(ApplicationName ?? "Home")">
        @if (!string.IsNullOrWhiteSpace(ApplicationLogo))
        {
            <img src="@ApplicationLogo" alt="" />
        }
        else
        {
            <span class="bb-brand-mark" aria-hidden="true">B</span>
        }
        <span>@(string.IsNullOrWhiteSpace(ApplicationName) ? "Blazor Blogs" : ApplicationName)</span>
    </a>

    <nav class="bb-primary-nav" aria-label="Primary navigation">
        <NavLink href="/" Match="NavLinkMatch.All">Blog</NavLink>
        <NavLink href="filedownloads">Downloads</NavLink>
        <NavLink href="Account/Manage/Newsletter">Newsletter</NavLink>
        <AuthorizeView Roles="Administrators">
            <Authorized>
                <NavLink href="administration">Administration</NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>

    <div class="bb-account-nav">
        <LoginDisplay />
    </div>
</header>

@code {
    [Parameter] public string ApplicationName { get; set; }
    [Parameter] public string ApplicationLogo { get; set; }
}
