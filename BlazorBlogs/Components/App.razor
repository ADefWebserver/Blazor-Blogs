<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <meta name="revised" content="Saturday, January 7th, 2025, 5:00 am" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="BlazorBlogs.styles.css" />  
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/default.css" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <HeadOutlet @rendermode="PageRenderMode" />
    <RadzenTheme Theme="default" @rendermode="InteractiveServer" />
    @if (ThemeStylesheetUrl is not null)
    {
        <link rel="stylesheet" href="@ThemeStylesheetUrl" data-theme-package="true" />
    }
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
    <script src="js/themes.js"></script>
    <script async src='https://www.google-analytics.com/analytics.js'></script>

    <script>
        (function () {
            let newsletterUnloadHandler;
            window.newsletterLeaveWarning = function (enabled) {
                if (enabled && !newsletterUnloadHandler) {
                    newsletterUnloadHandler = function (event) {
                        event.preventDefault();
                        event.returnValue = '';
                    };
                    window.addEventListener('beforeunload', newsletterUnloadHandler);
                } else if (!enabled && newsletterUnloadHandler) {
                    window.removeEventListener('beforeunload', newsletterUnloadHandler);
                    newsletterUnloadHandler = null;
                }
            };
            window.gaFunctions = {
                gaTracking: function (gaTrackingID) {
                    (ga.q = ga.q || []).push(arguments);
                    ga.l = +new Date;
                    ga('create', gaTrackingID, 'auto');
                    ga('send', 'pageview');
                }
            };
            window.DisqusFunctions = {
                createDisqus: function (disqusThreadElement, disqusSrc) {
                    var dsq = document.createElement('script');
                    dsq.type = 'text/javascript';
                    dsq.async = true;
                    dsq.src = disqusSrc;
                    dsq.disqus_container_id = 'disqus_thread';
                    disqusThreadElement.appendChild(dsq);
                },
                resetDisqus: function (newIdentifier, newUrl, newTitle) {
                    try {
                        DISQUS.reset({
                            reload: true,
                            config: function () {
                                this.page.identifier = newIdentifier;
                                this.page.url = newUrl;
                                this.page.title = newTitle;
                            }
                        });
                    }
                    catch (err) {
                        // do nothing
                    }
                }
            };
        })();
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    [Inject] private IThemePackageService ThemePackages { get; set; } = default!;
    [Inject] private ILogger<App> Logger { get; set; } = default!;
    private string ThemeStylesheetUrl { get; set; }

    private IComponentRenderMode PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (TryGetPreviewId(HttpContext.Request.Path, out var previewId)
                && HttpContext.User.IsInRole("Administrators"))
            {
                ThemeStylesheetUrl = await ThemePackages.GetStylesheetUrlAsync(previewId);
            }
            else
            {
                ThemeStylesheetUrl = await ThemePackages.GetActiveStylesheetUrlAsync();
            }
        }
        catch (Exception ex) when (ex is ThemePackageValidationException
                                       or IOException
                                       or UnauthorizedAccessException
                                       or System.Data.Common.DbException)
        {
            ThemeStylesheetUrl = null;
            Logger.LogWarning(ex, "Theme stylesheet is unavailable; using built-in styles.");
        }
    }

    private static bool TryGetPreviewId(PathString path, out Guid packageId)
    {
        const string prefix = "/settings/themes/preview/";
        var value = path.Value;
        if (value is not null && value.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
            && Guid.TryParseExact(value[prefix.Length..].Trim('/'), "D", out packageId))
        {
            return true;
        }

        packageId = Guid.Empty;
        return false;
    }
}
